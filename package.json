{
  "name": "whyburn",
  "version": "0.0.0",
  "description": "Find out why your AI coding agents burn tokens — and what to change.",
  "keywords": [
    "claude-code",
    "ai-coding",
    "llm",
    "token-usage",
    "cost-optimization",
    "mcp",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://github.com/ajaykauthale1/whyburn#readme",
  "bugs": {
    "url": "https://github.com/ajaykauthale1/whyburn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajaykauthale1/whyburn.git"
  },
  "author": "Ajay Kauthale",
  "type": "module",
  "bin": {
    "whyburn": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "prepare": "husky"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
